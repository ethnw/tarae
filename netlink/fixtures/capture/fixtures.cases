# The cases fixtures.sh keeps from the capture logs, one a line: `sent NAME` — its last send, what the crate's (or
# tarae's) bytes are held against; `recv NAME` — its answers, what the tests read or seed the parser loop with.
# r6: the table, chains and t1's rules (with sets) as nft and ip sent them
sent create-table
sent create-table-owner
sent create-chain-route
sent create-chain-prerouting
sent create-batch
sent rule-out-dns
sent rule-pre-dns4
sent rule-pre-dns6
sent rule-pre-tcp4
sent rule-pre-tcp6
sent rule-pre-udp4
sent rule-pre-udp6
sent route-default4
sent route-default6
sent route-local4
sent route-local6
sent rule-fwmark4
sent rule-fwmark6
sent rule-fwmark4-mask
# r6b: the sets split, one rule an element
sent split-out-lo4
sent split-out-session4
sent split-out-lo6
sent split-out-session6
sent split-out-tcp
sent split-out-udp
sent split-out-dns
sent split-pre-socket-tcp
sent split-pre-socket-udp
sent split-pre-lo4
sent split-pre-session4
sent split-pre-lo6
sent split-pre-session6
sent pre-drop
sent pre-socket-plain
# r6g: 6g's `socket cgroupv2`
sent split-out-cgroup
# r6d: 6d's — a mark found kept (bit 0 added), none set in prerouting; the whole ruleset so
sent keep-out-tcp
sent keep-out-udp
sent keep-out-dns
sent keep-pre-socket-tcp
sent keep-pre-socket-udp
sent keep-pre-dns4
sent keep-pre-dns6
sent keep-pre-tcp4
sent keep-pre-tcp6
sent keep-pre-udp4
sent keep-pre-udp6
sent create-batch-6d
# r6d's policy rule: bit 0 under its mask (`fwmark 0x1/0x1`)
sent rule-fwmark4-bit
sent rule-fwmark6-bit
# r6e: 6e's — TCP to port 53, the loopback resolvers too, kept for the session; the whole ruleset so
sent keep-out-dns-tcp
sent keep-pre-dns-tcp4
sent keep-pre-dns-tcp6
sent create-batch-6e
# r6e2 (6e's review): a question to port 53 a session's own socket is bound to goes to it
sent own-pre-dns-udp
sent own-pre-dns-tcp
sent create-batch-6e2
# the kernel's answers
recv err-exists
recv err-eperm
recv err-route-exists
recv err-exists-again
recv err-no-chain
recv err-route-prefix
recv dump-rules
recv dump-routes4
recv dump-routes6
recv dump-rules4
recv dump-rules6
recv route-default4
recv rule-fwmark4
recv err-chain-exists
